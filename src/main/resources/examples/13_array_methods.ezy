// 배열 메서드
// 배열 객체에 내장된 다양한 메서드들을 다룬다

arr: number[] = [3, 1, 4, 1, 5, 9, 2, 6]

println("원본: ")
for (n: number in arr) {
    print("${n} ")
}
println("")

// 검색 메서드: contains, indexOf
println("contains 5: ${arr.contains(5)}")
println("contains 7: ${arr.contains(7)}")
println("indexOf 4: ${arr.indexOf(4)}")

// 상태 확인 메서드
println("isEmpty: ${arr.isEmpty()}")
println("isNotEmpty: ${arr.isNotEmpty()}")

// sort(): 오름차순 정렬
arr.sort()
println("\n정렬 후: ")
for (n: number in arr) {
    print("${n} ")
}
println("")

// reverse(): 요소 순서를 뒤집기
arr.reverse()
println("역순 후: ")
for (n: number in arr) {
    print("${n} ")
}
println("")

// removeAt(): 지정 인덱스 요소 제거
arr.removeAt(0)
println("첫 번째 제거 후: ")
for (n: number in arr) {
    print("${n} ")
}
println("")

println("길이: ${arr.length()}")
