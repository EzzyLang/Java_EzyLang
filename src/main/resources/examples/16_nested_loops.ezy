// 중첩 반복문
// 루프 안에 루프를 중첩하여 2차원 패턴을 만든다

// 이중 for 문으로 구구단 출력
println("=== 구구단 (2~4단) ===")
for (i: number in 2 .. 4) {
    for (j: number in 1 .. 9) {
        println("${i} x ${j} = ${i * j}")
    }
    println("")
}

// 중첩 루프로 별(*) 피라미드 패턴 생성
println("=== 피라미드 ===")
for (i: number in 1 .. 5) {
    line: string = ""
    for (j: number in 1 .. i) {
        line = line + "* "
    }
    println(line)
}
