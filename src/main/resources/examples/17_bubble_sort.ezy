// 버블 정렬
// 인접한 두 요소를 반복 비교·교환하여 배열을 정렬하는 알고리즘

arr: number[] = [64, 34, 25, 12, 22, 11, 90]

println("정렬 전: ")
for (n: number in arr) {
    print("${n} ")
}
println("")

// 버블 정렬: O(n²) 시간복잡도
// 외부 루프(i)는 패스 횟수, 내부 루프(j)는 인접 요소 비교
func bubbleSort(arr: number[]): void {
    n: number = arr.length()
    for (i: number in 0 .. n - 2) {
        for (j: number in 0 .. n - i - 2) {
            if (arr[j] > arr[j + 1]) {
                // 인접 요소가 역순이면 교환(swap)
                temp: number = arr[j]
                arr[j] = arr[j + 1]
                arr[j + 1] = temp
            }
        }
    }
}

bubbleSort(arr)

println("정렬 후: ")
for (n: number in arr) {
    print("${n} ")
}
println("")
