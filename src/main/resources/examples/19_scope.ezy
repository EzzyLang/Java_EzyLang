// 변수 스코프
// 변수의 유효 범위(스코프)가 블록 {}에 의해 결정된다

// 외부 스코프 변수
x: number = 10
println("외부 x: ${x}")

// 블록 안에서 선언한 변수는 블록 안에서만 유효
{
    y: number = 20
    println("내부 y: ${y}")
    println("내부에서 외부 x 접근: ${x}")  // 외부 변수는 내부에서 접근 가능
}
// 이 시점에서 y 는 스코프 밖이므로 접근 불가

// 루프 변수(i)도 루프 블록 안에서만 유효
count: number = 0
for (i: number in 1 .. 5) {
    count += i
}
println("1~5 합: ${count}")
